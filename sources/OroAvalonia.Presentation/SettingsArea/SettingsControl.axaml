<UserControl
	x:Class="DustInTheWind.OroAvalonia.Presentation.SettingsArea.SettingsControl"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:dataConverters="using:DustInTheWind.OroAvalonia.Presentation.DataConverters"
    xmlns:shapes="using:DustInTheWind.ClockAvalonia.Shapes"

	mc:Ignorable="d"
	d:DesignWidth="800"
	d:DesignHeight="450"
    Foreground="Black">
	
    <UserControl.Resources>
        <dataConverters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Top">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Vertical">

            <TextBlock
                Text="General"
                FontSize="14"
                FontWeight="DemiBold"/>

            <CheckBox
                IsChecked="{Binding KeepOnTop}"
                Content="Keep on top"
                Margin="15 8 0 0"/>

        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            Margin="0 10 0 0">

            <TextBlock
                Text="Clock Direction"
                FontSize="14"
                FontWeight="DemiBold" />

            <StackPanel 
                Orientation="Vertical"
                Margin="15 8 0 0">

                <RadioButton 
                    Content="Clockwise"
                    IsChecked="{Binding ClockDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shapes:RotationDirection.Clockwise}}"
                    Margin="0 0 0 8"
                    VerticalAlignment="Center"/>

                <RadioButton 
                    Content="Counterclockwise"
                    IsChecked="{Binding ClockDirection, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shapes:RotationDirection.Counterclockwise}}"
                    VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Orientation="Vertical"
            Margin="0 10 0 0">

            <TextBlock
                Text="Refresh Rate (times per second)"
                FontSize="14"
                FontWeight="DemiBold"/>

            <TextBox
                Text="{Binding RefreshRate, UpdateSourceTrigger=PropertyChanged}"
                Margin="15 8 0 0"
                VerticalAlignment="Center"/>

        </StackPanel>

    </Grid>

</UserControl>
